[{"title":"跳一跳","description":"","icon":"🕹️","coverColor":"#9F7AEA","htmlContent":"<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\r\n<title>极简跳一跳 - 优化版</title>\r\n<style>\r\n  body { margin: 0; background: #e0e9f0; display: flex; justify-content: center; align-items: center; height: 100vh; font-family: -apple-system, sans-serif; overflow: hidden; touch-action: none; }\r\n  #game-container { position: relative; width: 380px; height: 600px; background: #fff; box-shadow: 0 20px 50px rgba(0,0,0,0.15); border-radius: 16px; overflow: hidden; }\r\n  canvas { display: block; background: linear-gradient(to bottom, #daf0f8, #ffffff); }\r\n  .ui { position: absolute; top: 30px; left: 0; width: 100%; text-align: center; pointer-events: none; }\r\n  #score { font-size: 64px; font-weight: 900; color: #2a7fa0; opacity: 0.8; margin: 0; }\r\n  .hint { font-size: 14px; color: #8aabbb; font-weight: bold; letter-spacing: 1px; }\r\n  #overlay { position: absolute; inset: 0; background: rgba(255,255,255,0.85); display: flex; flex-direction: column; justify-content: center; align-items: center; visibility: hidden; opacity: 0; transition: 0.3s; z-index: 10; }\r\n  #overlay.active { visibility: visible; opacity: 1; pointer-events: auto; }\r\n  h2 { color: #354e5e; margin-bottom: 5px; }\r\n  #final-score { font-size: 24px; color: #2a7fa0; font-weight: bold; margin-bottom: 20px; }\r\n  button { padding: 12px 40px; font-size: 18px; background: #2a7fa0; color: #fff; border: none; border-radius: 30px; cursor: pointer; box-shadow: 0 4px 15px rgba(42,127,160,0.3); }\r\n  button:active { transform: scale(0.95); }\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div id=\"game-container\">\r\n  <div class=\"ui\">\r\n    <p id=\"score\">0</p >\r\n    <div class=\"hint\">按住蓄力 · 松开起跳</div>\r\n  </div>\r\n  <canvas id=\"canvas\"></canvas>\r\n  <div id=\"overlay\">\r\n    <h2>游戏结束</h2>\r\n    <p id=\"final-score\">得分: 0</p >\r\n    <button id=\"retry-btn\">再来一次</button>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\nconst cvs = document.getElementById('canvas');\r\nconst ctx = cvs.getContext('2d');\r\nconst scoreEl = document.getElementById('score');\r\nconst overlay = document.getElementById('overlay');\r\nconst finalScoreEl = document.getElementById('final-score');\r\n\r\nconst W = 380, H = 600;\r\ncvs.width = W; cvs.height = H;\r\n\r\nlet state = 'idle'; // idle, charging, jumping, dead\r\nlet score = 0;\r\nlet camX = 0, targetCamX = 0;\r\nlet platforms = [];\r\nlet player = { x: 0, y: 0, r: 16, charge: 0, jumpT: 0 };\r\nlet lastTime = 0;\r\n\r\nfunction init() {\r\n    score = 0;\r\n    scoreEl.textContent = '0';\r\n    camX = 0; targetCamX = 0;\r\n    platforms = [];\r\n    overlay.classList.remove('active');\r\n    \r\n    // 初始平台\r\n    platforms.push({ x: 80, y: H * 0.7, w: 100, color: '#b4daf0' });\r\n    spawnPlat();\r\n    \r\n    player.x = platforms[0].x;\r\n    player.y = platforms[0].y - 16;\r\n    player.charge = 0;\r\n    state = 'idle';\r\n}\r\n\r\nfunction spawnPlat() {\r\n    const last = platforms[platforms.length - 1];\r\n    // 动态难度：分数越高，平台越窄（最小45），间距随机性越大\r\n    const difficulty = Math.min(score / 30, 1);\r\n    const w = 90 - (difficulty * 45) + Math.random() * 20;\r\n    const gap = 90 + (difficulty * 140) + Math.random() * 60;\r\n    const y = H * 0.7 + (Math.random() - 0.5) * 80;\r\n    \r\n    platforms.push({\r\n        x: last.x + gap,\r\n        y: y,\r\n        w: w,\r\n        color: `hsl(${200 + Math.random()*30}, 45%, ${65 + Math.random()*15}%)`\r\n    });\r\n    if (platforms.length > 5) platforms.shift();\r\n}\r\n\r\nfunction update(ts) {\r\n    const dt = Math.min((ts - lastTime) / 1000, 0.1);\r\n    lastTime = ts;\r\n\r\n    camX += (targetCamX - camX) * 0.1;\r\n\r\n    if (state === 'charging') {\r\n        player.charge = Math.min(player.charge + dt * 1.5, 2.2); // 限制蓄力上限\r\n    }\r\n\r\n    if (state === 'jumping') {\r\n        player.jumpT += dt * 3.2; \r\n        const t = Math.min(player.jumpT, 1);\r\n        \r\n        // 抛物线插值\r\n        player.x = player.startX + (player.targetX - player.startX) * t;\r\n        const arc = Math.sin(t * Math.PI) * 120;\r\n        player.y = player.startY + (player.targetY - player.startY) * t - arc;\r\n\r\n        if (t >= 1) {\r\n            checkLand();\r\n        }\r\n    }\r\n    \r\n    draw();\r\n    requestAnimationFrame(update);\r\n}\r\n\r\nfunction checkLand() {\r\n    const target = platforms[platforms.length - 1];\r\n    const halfW = target.w / 2;\r\n    const tolerance = 6; // 边缘容错\r\n\r\n    if (Math.abs(player.x - target.x) <= halfW + tolerance) {\r\n        score++;\r\n        scoreEl.textContent = score;\r\n        targetCamX = player.x - 80;\r\n        spawnPlat();\r\n        state = 'idle';\r\n        player.charge = 0;\r\n    } else {\r\n        state = 'dead';\r\n        setTimeout(() => {\r\n            finalScoreEl.textContent = \"得分: \" + score;\r\n            overlay.classList.add('active');\r\n        }, 500);\r\n    }\r\n}\r\n\r\nfunction draw() {\r\n    ctx.clearRect(0, 0, W, H);\r\n    ctx.save();\r\n    ctx.translate(-camX, 0);\r\n\r\n    // 绘制平台\r\n    platforms.forEach(p => {\r\n        ctx.fillStyle = p.color;\r\n        ctx.beginPath();\r\n        // 绘制带圆角的矩形平台\r\n        const r = 8;\r\n        ctx.roundRect(p.x - p.w/2, p.y, p.w, 25, r);\r\n        ctx.fill();\r\n        // 平台阴影装饰\r\n        ctx.fillStyle = 'rgba(0,0,0,0.05)';\r\n        ctx.fillRect(p.x - p.w/2, p.y + 20, p.w, 5);\r\n    });\r\n\r\n    // 绘制玩家\r\n    ctx.save();\r\n    const squish = state === 'charging' ? (player.charge * 8) : 0;\r\n    ctx.fillStyle = '#2a7fa0';\r\n    ctx.translate(player.x, player.y + squish/2);\r\n    ctx.scale(1 + squish/50, 1 - squish/32);\r\n    ctx.beginPath();\r\n    ctx.arc(0, 0, player.r, 0, Math.PI * 2);\r\n    ctx.fill();\r\n    // 眼神\r\n    ctx.fillStyle = 'white';\r\n    ctx.beginPath(); ctx.arc(6, -4, 3, 0, 7); ctx.fill();\r\n    ctx.restore();\r\n\r\n    // 蓄力条特效\r\n    if (state === 'charging') {\r\n        ctx.strokeStyle = 'rgba(42, 127, 160, 0.5)';\r\n        ctx.lineWidth = 4;\r\n        ctx.beginPath();\r\n        ctx.arc(player.x, player.y, player.r + 12, -Math.PI/2, -Math.PI/2 + (player.charge/2.2) * Math.PI * 2);\r\n        ctx.stroke();\r\n    }\r\n\r\n    ctx.restore();\r\n}\r\n\r\n// 事件处理\r\nfunction handleStart(e) {\r\n    if (e.cancelable) e.preventDefault();\r\n    if (state === 'idle') {\r\n        state = 'charging';\r\n        player.charge = 0;\r\n    }\r\n}\r\n\r\nfunction handleEnd(e) {\r\n    if (state === 'charging') {\r\n        player.startX = player.x;\r\n        player.startY = player.y;\r\n        const jumpDist = player.charge * 160 + 30; // 蓄力距离映射\r\n        player.targetX = player.x + jumpDist;\r\n        player.targetY = platforms[platforms.length-1].y - 16;\r\n        player.jumpT = 0;\r\n        state = 'jumping';\r\n    }\r\n}\r\n\r\nwindow.addEventListener('touchstart', handleStart, {passive: false});\r\nwindow.addEventListener('touchend', handleEnd);\r\nwindow.addEventListener('mousedown', handleStart);\r\nwindow.addEventListener('mouseup', handleEnd);\r\ndocument.getElementById('retry-btn').onclick = init;\r\n\r\n// 启动游戏\r\ninit();\r\nrequestAnimationFrame(update);\r\n</script>\r\n</body>\r\n</html>","createdAt":1776326391588,"id":1}]